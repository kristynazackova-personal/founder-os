# ---- Core ----------------------------------------------------------------
# Public base URL of this deployment (used in checkout links, OAuth callbacks
# and the snippet install instructions). No trailing slash.
APP_URL=http://localhost:3000
# Signs session cookies. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string
# 32-byte key (64 hex chars) used to encrypt connected-account credentials at
# rest. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ---- Database ------------------------------------------------------------
# Any Postgres. Neon hosts use Neon's HTTP driver; everything else (Railway
# Postgres, Supabase, RDS…) uses node-postgres. TLS is on when the URL has
# sslmode=require; DATABASE_SSL=true|false overrides. Leave unset to run on an
# embedded PGlite database in ./.data (zero setup, local development only —
# on a host like Railway the filesystem is wiped on every deploy).
DATABASE_URL=
# Check a deployment with GET /api/health — it reports the driver and any DB error.

# ---- Revenue sources (read) ---------------------------------------------
# Stripe Connect (read-only OAuth). The platform account's secret key and the
# Connect OAuth client id (ca_...). Founders never paste a Stripe key.
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=

# ---- Google Ads (read-only reporting) -----------------------------------
# Ad spend per campaign. GA4 only reports cost when its Google Ads link
# delivers it, which it does not for app campaigns, so this is the reliable
# source. All three belong to FOUNDER OS, not to each founder: one approved
# developer token serves every customer, and a founder supplies only their
# customer id and an OAuth refresh token with the `adwords` scope.
# Full one-time setup, including the Cloud project and the 7-day refresh
# token trap: docs/GOOGLE_ADS_SETUP.md
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Google ships a new major version monthly and sunsets each after about a
# year. Default v25 (current as of Sept 2026); bump when it retires.
GOOGLE_ADS_API_VERSION=v25

# ---- Wrapped checkout (merchant of record) ------------------------------
# dodo | polar | mock. "mock" needs no keys and simulates payments in test mode.
CHECKOUT_PROVIDER=mock
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
POLAR_ACCESS_TOKEN=
POLAR_ORGANIZATION_ID=
POLAR_WEBHOOK_SECRET=
# Secret used to sign mock-provider webhooks (any string).
MOCK_WEBHOOK_SECRET=mock-secret

# ---- Billing for Founder OS itself (Stripe) -----------------------------
# Prices for the $39/mo (wrapped-checkout founders) and $29/mo
# (Stripe-connected founders) plans.
STRIPE_PRICE_WRAPPED_39=
STRIPE_PRICE_CONNECTED_29=
STRIPE_WEBHOOK_SECRET=

# ---- Gate research (optional) -------------------------------------------
# Gates are the thresholds a B2C metric is judged against. Every app gets
# them at creation from published benchmarks for its industry and how it
# sells (src/lib/domain/gates.ts) — that layer is deterministic and needs no
# key at all.
#
# Set a key here and a second pass runs per app: it looks up comparable
# products and can tighten or loosen a band, but only with a citation —
# anything it cannot attribute is discarded (parseResearchedGates). The pass
# is fail-soft and never blocks app creation, so leaving this unset is a
# complete product, not a degraded one.
# GATE_RESEARCH_API_KEY=
# Defaults to gemini-2.5-flash with Google Search grounding enabled.
# GATE_RESEARCH_MODEL=gemini-2.5-flash
